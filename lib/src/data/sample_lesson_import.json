  "phases": [
    {
      "id": "warmup_01",
      "type": "warmup",
      "title": "Warm-up Reasoning Sprint",
      "durationSeconds": 300,

      "prompt": "A self-driving car detects an obstacle with 78% confidence. Should it brake immediately, gather more data, or do something else? Why?",

      "instructions": [
        "Discuss with your team",
        "Submit one team answer",
        "Be ready to explain your reasoning"
      ],

      "submission": {
        "enabled": true,
        "mode": "team",
        "confidenceSelector": true
      },

      "teacherNotes": [
        "Look for tradeoff reasoning",
        "Encourage multiple valid approaches",
        "Avoid revealing a single 'correct' answer"
      ]
    },

    {
      "id": "mini_lesson_01",
      "type": "instruction",
      "title": "What Is an Algorithm?",
      "durationSeconds": 420,

      "teacherNotes": [
        "Define algorithms as step-by-step procedures",
        "Use a simple real-world example briefly",
        "Transition quickly into CS examples",
        "Emphasize precision and ambiguity"
      ],

      "display": {
        "showObjectives": true,
        "showTimer": true,
        "showVocabulary": true
      }
    },

    {
      "id": "challenge_01",
      "type": "challenge",
      "title": "Debug the Instructions",
      "durationSeconds": 480,

      "prompt": "Write instructions for a robot to make toast. Another team will follow them literally.",

      "instructions": [
        "Be extremely specific",
        "Think like a computer",
        "Consider edge cases",
        "Test your algorithm"
      ],

      "submission": {
        "enabled": true,
        "mode": "team"
      },

      "teacherNotes": [
        "Look for skipped assumptions",
        "Celebrate funny failures",
        "Connect mistakes to real debugging"
      ]
    },

    {
      "id": "discussion_01",
      "type": "discussion",
      "title": "Class Debrief",
      "durationSeconds": 300,

      "discussionPrompts": [
        "What mistakes happened most often?",
        "Why are computers bad at assumptions?",
        "How does debugging help programmers?",
        "What made some instructions more reliable?"
      ],

      "display": {
        "showLeaderboard": false,
        "showTeamMap": true
      }
    },

    {
      "id": "reflection_01",
      "type": "reflection",
      "title": "Exit Reflection",
      "durationSeconds": 180,

      "reflectionQuestions": [
        "What was one thing your team improved today?",
        "What confused you most?",
        "How confident do you feel about algorithms so far?",
        "What is one thing you want to learn next?"
      ],

      "submission": {
        "enabled": true,
        "mode": "individual"
      },

      "teacherNotes": [
        "Use responses to guide tomorrow's pacing",
        "Identify common misconceptions",
        "Look for students needing extra support"
      ]
    }
  ]
}